generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL is no longer set here. It is resolved by
// `prisma.config.ts` (CLI/Migrate) and by the driver adapter passed to
// `PrismaClient` at runtime (see src/lib/db.ts).
datasource db {
  provider = "postgresql"
}

// Fase 0 catalog subset. See design D2 (sdd/fase-0-fundaciones/design):
// - cuid string IDs
// - material/size are free-form strings, not enums (small, evolving catalog)
// - price_cents is always an integer (never float) — see spec "Money and Date Invariants"
// - timestamps use timestamptz to make the UTC storage invariant explicit
// - slugs preserve the existing WooCommerce URLs (see design D4)
model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  // wooId: immutable WooCommerce Store API integer PK, set on every import.
  // Nullable to accommodate pre-import rows; provenance/future-diffing only
  // — `slug` remains the upsert key, never `wooId`.
  wooId       Int?     @unique
  // tags: owner-curated highlight badges (design D11), additive to the WooCommerce
  // import. NEVER written by `scripts/catalog/import.ts` — a re-import upsert
  // that touched this column would silently clear every tag the owner set by
  // hand. Defaults to empty; at most one tag is rendered (BEST_SELLER over NEW).
  tags        ProductTag[] @default([])

  categories Category[]
  variants   ProductVariant[]
  media      ProductMedia[]
  reviews    Review[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

enum ProductTag {
  BEST_SELLER
  NEW
}

model ProductVariant {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku            String  @unique
  material       String?
  sizeMm         String?
  priceCents     Int
  // salePriceCents: promotional price in integer cents, set iff the source
  // product/variant is on_sale (see design D5). Null = not on sale.
  salePriceCents Int?
  // stock: on-hand quantity. No Fase-1 data source (the public WooCommerce
  // Store API exposes no quantities); the catalog import NEVER writes this
  // column. 0 = unknown/unmanaged quantity, NOT "zero available". Read
  // `inStock` for customer-facing availability — never infer it from `stock`.
  stock          Int     @default(0)
  // inStock: customer-facing availability sourced verbatim from the Store
  // API `is_in_stock` field. The ONLY authoritative availability signal —
  // the import ALWAYS sets this explicitly, never inferred from `stock`.
  inStock        Boolean @default(false)
  // wooId: immutable WooCommerce Store API integer PK (variation id, or the
  // product id for a synthesized simple-product variant). Nullable to
  // accommodate pre-import rows; provenance/future-diffing only — `sku`
  // remains the upsert key, never `wooId`.
  wooId          Int?    @unique

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model Category {
  id   String @id @default(cuid())
  slug String @unique
  name String

  products Product[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model ProductMedia {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url      String
  alt      String?
  position Int     @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
}

// Fase 2 (design D9/D10). Read-only from the app's point of view: there is no
// public submission endpoint or moderation UI in this phase. Rows are
// inserted/approved by hand via psql, following REVIEWS.md at the repo root.
// The rating range (1-5) cannot be expressed in Prisma's schema language, so
// it is added as a hand-appended CHECK constraint in the migration SQL.
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  rating Int
  title  String?
  body   String

  authorName String
  // authorEmail: optional, collected for the owner's own follow-up only.
  // MUST NEVER be selected by a DAL query or serialized into any DTO/HTML
  // [INV-3] — see src/lib/data/reviews.ts.
  authorEmail String?

  status ReviewStatus @default(PENDING)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([productId, status])
}
